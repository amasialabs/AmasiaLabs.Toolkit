<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    
    <PackageId>AmasiaLabs.Toolkit.FlowflakeId</PackageId>
    <Version>1.5.0</Version>
    <Description>Snowflake-like ID generator with configurable epoch/time source (Flowflake)</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmasiaLabs.Toolkit.FlowflakeId.Abstractions\AmasiaLabs.Toolkit.FlowflakeId.Abstractions.csproj" />
  </ItemGroup>

  <!-- Microsoft.Extensions.Options needs no package reference: the .NET 11 shared framework
       (Microsoft.NETCore.App) carries it, and NuGet asks for the reference to go (NU1510). -->

</Project>
