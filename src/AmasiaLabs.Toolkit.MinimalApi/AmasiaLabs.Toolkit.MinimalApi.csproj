<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        
        <PackageId>AmasiaLabs.Toolkit.MinimalApi</PackageId>
        <Version>1.8.3</Version>
        <Description>Toolkit &amp; Boilerplate for Minimal API projects</Description>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
      <!-- Promote the transitive Microsoft.OpenApi (pulled in by Microsoft.AspNetCore.OpenApi)
           to a direct reference, so the centrally-managed version and its range win and the
           range is written into this package's nuspec. Version is supplied implicitly by
           Central Package Management (Directory.Packages.props).
           Each line of AspNetCore.OpenApi is built against one major of Microsoft.OpenApi, and
           the two cannot be mixed: AspNetCore.OpenApi 10.0.x went with 2.x (3.x broke its
           source generator, which uses the IOpenApiMediaType.Example setter removed in 3.x ->
           CS0200, and its runtime, MissingMethodException: OpenApiResponse.get_Content);
           AspNetCore.OpenApi 11.0.x goes with 3.x and itself requires [3.11.0, 4.0.0). The
           range [3.11.0,4.0.0) keeps a bulk bump from moving Microsoft.OpenApi to 4.x. -->
      <PackageReference Include="Microsoft.OpenApi" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    </ItemGroup>

    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
